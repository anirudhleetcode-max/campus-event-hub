# ─────────────────────────────────────────────────────────────
# Campus Event Hub — environment variables
# Copy to .env (development) and fill in. Never commit real secrets.
# Use SEPARATE values per environment (development / staging / production).
# ─────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development

# PostgreSQL. DATABASE_URL may point to a pooler (PgBouncer, transaction mode, add
# ?pgbouncer=true); DIRECT_DATABASE_URL must be a direct connection — it is used
# for migrations and for realtime LISTEN/NOTIFY.
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_hub?schema=public
DIRECT_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_hub?schema=public

# Secret for session token hashing (32+ chars). Generate: openssl rand -base64 32
AUTH_SECRET=

# Shared secret for cron endpoints (/api/cron/*). Generate: openssl rand -hex 24
CRON_SECRET=

# Public base URL (used in emails, certificate QR codes, CSRF origin checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay — use TEST keys (rzp_test_…) outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend API key). Without it, emails are logged to email_logs as SKIPPED.
EMAIL_API_KEY=
EMAIL_FROM="Campus Event Hub <no-reply@yourdomain.com>"

# S3-compatible object storage (AWS S3, Cloudflare R2, Supabase Storage S3, MinIO).
# STORAGE_URL is the S3 endpoint (leave empty for AWS S3). In development, if these
# are empty, uploads are stored in .data/uploads (not in production).
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=auto
# Public base URL for uploaded objects (CDN / public bucket URL)
STORAGE_PUBLIC_URL=

# Optional
# LOG_LEVEL=info
# NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
