# ─────────────────────────────────────────────────────────────────────────────
# Campus Event Hub — environment variables
#
#   Development: cp .env.example .env, fill in the CORE section, done.
#   Staging:     separate database, TEST Razorpay keys, real email/storage.
#   Production:  set these in your host's secret store (e.g. Vercel → Settings →
#                Environment Variables), NEVER in a committed file.
#
# Use DIFFERENT secrets per environment. Never commit a real value: .env* is
# git-ignored except this example file.
#
# Check your configuration at any time (never prints secret values):
#   npm run check:config
# ─────────────────────────────────────────────────────────────────────────────

# ═══ CORE (required everywhere) ══════════════════════════════════════════════

# development | staging | production   (test is used by the automated tests)
# Only APP_ENV=production may use LIVE Razorpay keys, and production requires
# cloud storage, cron and https URLs (see check:config).
APP_ENV=development

# PostgreSQL 14+. DATABASE_URL may point to a pooler (PgBouncer in transaction
# mode: add ?pgbouncer=true). DIRECT_DATABASE_URL must be a DIRECT connection:
# it is used for migrations and realtime LISTEN/NOTIFY.
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_hub?schema=public
DIRECT_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_hub?schema=public

# Secret for session token hashing, at least 32 characters.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the app: used in emails, certificate QR codes and the
# CSRF origin check. Must be https:// in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══ SCHEDULED JOBS (required in production) ═════════════════════════════════
# Shared secret for /api/cron/* (min 16 characters). Callers must send
#   Authorization: Bearer <CRON_SECRET>
# Vercel Cron sends this header automatically when CRON_SECRET is set.
# Without it, every cron call is rejected: no reminders, no automatic
# start/complete, no feedback requests, no seat-hold expiry.
# Generate: openssl rand -hex 24
CRON_SECRET=

# ═══ PAYMENTS — Razorpay (optional; needed for paid events) ══════════════════
# Dashboard → Account & Settings → API Keys.
#   TEST keys (rzp_test_…): development and staging. No real money moves.
#   LIVE keys (rzp_live_…): ONLY with APP_ENV=production. Anywhere else they
#                           are refused and paid registration is disabled.
# RAZORPAY_WEBHOOK_SECRET is the secret you choose when adding the webhook
# (Dashboard → Webhooks) for  <NEXT_PUBLIC_APP_URL>/api/webhooks/razorpay
# with events: payment.captured, payment.failed, payment.authorized,
# order.paid, refund.processed, refund.failed. Required in production.
# The key secret and webhook secret stay on the server; only the key id is
# sent to the browser (Checkout needs it).
# Without keys: paid registrations are refused with a clear message.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ═══ EMAIL — Resend (optional; in-app notifications work without it) ═════════
# API key from resend.com (starts with re_). EMAIL_FROM must use a domain you
# have VERIFIED in Resend (Domains → add DNS records), formatted as
#   "Display Name <address@your-verified-domain>"  or  address@domain
# Without EMAIL_API_KEY, emails are recorded in email_logs as SKIPPED.
# With a key but a missing/invalid EMAIL_FROM, nothing is sent (logged FAILED).
EMAIL_API_KEY=
EMAIL_FROM="Campus Event Hub <no-reply@yourdomain.com>"

# ═══ FILE STORAGE — S3-compatible (required in production) ═══════════════════
# Works with AWS S3, Cloudflare R2, Supabase Storage (S3), MinIO, etc.
# In development, leave STORAGE_BUCKET/KEY/SECRET empty to store uploads in
# .data/uploads. A PARTIAL configuration is an error (no silent fallback).
#
# STORAGE_URL        S3 API endpoint. Empty for AWS S3; for R2:
#                    https://<account-id>.r2.cloudflarestorage.com
# STORAGE_KEY        access key id      (server only)
# STORAGE_SECRET     secret access key  (server only)
# STORAGE_BUCKET     bucket name
# STORAGE_REGION     AWS region (e.g. ap-south-1) for AWS S3; "auto" for R2
# STORAGE_PUBLIC_URL public base URL that serves the bucket's objects (public
#                    bucket URL or CDN), e.g. https://cdn.yourdomain.com.
#                    REQUIRED with S3. It must allow anonymous GET of objects,
#                    and it is added to the Content-Security-Policy at BUILD
#                    time, so rebuild after changing it.
# The access key needs s3:PutObject on the bucket (uploads are write-only from
# the app; reads go through STORAGE_PUBLIC_URL).
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=

# ═══ OPTIONAL ════════════════════════════════════════════════════════════════
# LOG_LEVEL=info
# NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
