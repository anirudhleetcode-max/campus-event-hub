{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma migrate deploy && npm run build",
  "crons": [
    { "path": "/api/cron/event-status", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 3 * * *" }
  ]
}
